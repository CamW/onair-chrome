{
  "manifest_version": 3,
  
  "name": "On Air Tracking Extension",
  "description": "Monitors and reports on whether the user has WebRTC sessions or screen captures open. Users with open sessions are considered On-Air",
  "version": "1.0",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/onair_16.png",
      "32": "images/onair_32.png",
      "48": "images/onair_48.png",
      "128": "images/onair_128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["scripts/injected.js"],
      "matches": ["<all_urls>"],
      "use_dynamic_url": false
    }
  ],
  "icons": {
    "16": "images/onair_16.png",
    "32": "images/onair_32.png",
    "48": "images/onair_48.png",
    "128": "images/onair_128.png"
  }
}